{
  "name": "meet-live-assist",
  "version": "0.7.2",
  "private": true,
  "description": "Live meeting co-pilot for Google Meet and Zoom: transcript capture, colour-coded advice, action items, snapshots, chat and TTS, driven by your own local assistant.",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://krystiangw.github.io/meet-live-assist/",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "./build.sh",
    "build:public": "./build.sh --public",
    "test": "node test/run-all.mjs",
    "test:server": "node test/smoke.mjs",
    "test:mcp": "node test/mcp.mjs",
    "test:retention": "node test/retention.mjs",
    "test:panel": "node test/panel.mjs",
    "lint": "for f in src/*.js server/*.js; do node --check \"$f\" || exit 1; done",
    "test:limits": "node test/limits.mjs",
    "test:scope": "node test/scope.mjs",
    "test:wake": "node test/wake-failure.mjs",
    "test:burst": "node test/health-burst.mjs"
  }
}
