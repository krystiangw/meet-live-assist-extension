{
  "manifest_version": 3,
  "name": "Meet Live Assist (dev)",
  "version": "0.0.1",
  "description": "Live Google Meet assistant — captures the call transcript and shows it in a side panel. Phase 0 spike.",
  "permissions": ["sidePanel", "storage", "alarms"],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://127.0.0.1:8848/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "options_page": "src/options.html",
  "action": {
    "default_title": "Meet Live Assist"
  }
}
