{
  "manifest_version": 3,
  "name": "Meet Live Assist",
  "version": "0.1.0",
  "description": "Live Google Meet assistant — live transcript, colour-coded advice, smart screen snapshots, chat, and TTS that can speak into the call.",
  "icons": { "16": "src/icons/icon16.png", "32": "src/icons/icon32.png", "48": "src/icons/icon48.png", "128": "src/icons/icon128.png" },
  "permissions": ["sidePanel", "storage", "alarms", "tabCapture", "offscreen", "scripting"],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://127.0.0.1:8848/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "options_page": "src/options.html",
  "action": {
    "default_title": "Meet Live Assist",
    "default_icon": { "16": "src/icons/icon16.png", "32": "src/icons/icon32.png", "48": "src/icons/icon48.png", "128": "src/icons/icon128.png" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https: http://127.0.0.1:8848"
  },
  "commands": {
    "toggle-stt": {
      "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" },
      "description": "Toggle local speech-to-text capture of the Meet tab"
    }
  }
}
